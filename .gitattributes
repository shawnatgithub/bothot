# Normalize line endings: LF in repo and working tree on all platforms
* text=auto eol=lf

# Shell scripts must stay LF (needed on Git Bash / CI)
*.sh text eol=lf

# Windows-only files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.pdf binary
